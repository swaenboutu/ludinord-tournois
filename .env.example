# Serveur HTTP
PORT=3000

# Base de données MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=tournoi
DB_PASSWORD=change_me
DB_NAME=tournoi

# Secret de signature des sessions admin (chaîne aléatoire longue).
# Facultatif : si absent, un secret aléatoire est généré à chaque démarrage
# (les admins sont alors déconnectés à chaque redémarrage).
SESSION_SECRET=change_me_with_a_long_random_string
