<%- include('../partials/header', { title }) %>

<%- include('../partials/breadcrumb', { items: [
  { label: 'Tournois', href: '/tournaments' },
  { label: tournament.name },
] }) %>

<div class="tournament-head">
  <h1 class="tournament-name"><%= tournament.name %></h1>
  <% if (tournament.status === 'planned') { %>
    <span class="status-badge status-planned"><span class="status-dot"></span>Planifié</span>
  <% } else if (tournament.status === 'open') { %>
    <span class="status-badge status-open"><span class="status-dot"></span>En cours</span>
  <% } else { %>
    <span class="status-badge status-closed"><span class="status-dot"></span>Clôturé</span>
  <% } %>
</div>
<p class="muted">Équipes de <%= tournament.team_size %> joueur<%= tournament.team_size > 1 ? 's' : '' %>.</p>

<!-- Affichages TV, mis en avant en haut -->
<section class="tv-links">
  <a class="tv-button" href="/tournaments/<%= tournament.id %>/display" target="_blank" rel="noopener">
    📺 Affichage TV — Menu
  </a>
  <a class="tv-button" href="/tournaments/<%= tournament.id %>/display/pool" target="_blank" rel="noopener">
    📺 Affichage TV — Poule
  </a>
  <a class="tv-button" href="/tournaments/<%= tournament.id %>/display/final" target="_blank" rel="noopener">
    📺 Affichage TV — Phases finales
  </a>
  <a class="tv-button" href="/tournaments/<%= tournament.id %>/display/finale" target="_blank" rel="noopener">
    📺 Affichage TV — Finale
  </a>
  <a class="button" href="/tournaments/<%= tournament.id %>/player" target="_blank" rel="noopener">
    🎮 Espace joueur (lien à partager)
  </a>
</section>

<h2>Éléments globaux</h2>
<p class="section-hint">Jeux et équipes — partagés par toutes les phases du tournoi.</p>
<div class="hub-grid">
  <a class="hub-card" href="/tournaments/<%= tournament.id %>/games">
    <span class="hub-title">Jeux</span>
    <span class="hub-desc">Catalogue des jeux du tournoi</span>
  </a>
  <a class="hub-card" href="/tournaments/<%= tournament.id %>/teams">
    <span class="hub-title">Équipes</span>
    <span class="hub-desc">Équipes et joueurs</span>
  </a>
</div>

<h2>Phases du tournoi</h2>
<div class="hub-grid">
  <a class="hub-card" href="/tournaments/<%= tournament.id %>/pool">
    <span class="hub-title">Phase de poule</span>
    <span class="hub-desc">Manches, tirages et classement</span>
  </a>
  <a class="hub-card" href="/tournaments/<%= tournament.id %>/final">
    <span class="hub-title">Phase finale</span>
    <span class="hub-desc">Étapes à élimination</span>
  </a>
</div>


<div class="hub-grid">
  <% if (tournament.status === 'planned') { %>
    <form method="post" action="/tournaments/<%= tournament.id %>/start"
          onsubmit="return confirm('Démarrer ce tournoi ?');">
      <button type="submit" class="button-start">Démarrer ce tournois</button>
    </form>
  <% } else if (tournament.status === 'open') { %>
    <form method="post" action="/tournaments/<%= tournament.id %>/close"
          onsubmit="return confirm('Clôturer ce tournoi ?');">
      <button type="submit" class="button-danger">Clôturer ce tournois</button>
    </form>
  <% } else { %>
    <form method="post" action="/tournaments/<%= tournament.id %>/reopen"
          onsubmit="return confirm('Ré-ouvrir ce tournoi ?');">
      <button type="submit">Ré-ouvrir ce tournois</button>
    </form>
  <% } %>
</div>


<%- include('../partials/footer') %>
