<%- include('../partials/header', { title }) %>

<%- include('../partials/breadcrumb', { items: [
  { label: 'Tournois', href: '/tournaments' },
  { label: tournament.name },
] }) %>

<%
  var statusUi = {
    planned: {
      label: 'Planifié',
      className: 'status-planned',
      cardTitle: 'Tournoi planifié',
      cardDesc: 'Prêt à démarrer.',
    },
    open: {
      label: 'En cours',
      className: 'status-open',
      cardTitle: 'Tournoi en cours',
      cardDesc: 'Bonne chance à tous !',
    },
    closed: {
      label: 'Clôturé',
      className: 'status-closed',
      cardTitle: 'Tournoi clôturé',
      cardDesc: 'Merci à tous !',
    },
  };
  var ui = statusUi[tournament.status] || statusUi.closed;
%>

<header class="page-header">
  <div class="page-header-main">
    <div class="page-title-row tournament-head">
      <h1 class="tournament-name"><%= tournament.name %></h1>
      <span class="status-badge <%= ui.className %>">
        <span class="status-dot"></span><%= ui.label %>
      </span>
    </div>
    <p class="page-subtitle">Équipes de <%= tournament.team_size %> joueur<%= tournament.team_size > 1 ? 's' : '' %>.</p>
  </div>
  <aside class="status-card">
    <span class="status-card-icon">
      <%- include('../partials/icon', { name: 'calendar', cssClass: 'icon icon-md' }) %>
    </span>
    <div class="status-card-body">
      <span class="status-card-title"><%= ui.cardTitle %></span>
      <span class="status-card-desc"><%= ui.cardDesc %></span>
    </div>
  </aside>
</header>

<section class="tv-links" aria-label="Affichages et espace joueur">
  <%- include('../partials/nav-link', { href: `/tournaments/${tournament.id}/display`, label: 'Affichage TV — Menu', variant: 'tv' }) %>
  <%- include('../partials/nav-link', { href: `/tournaments/${tournament.id}/display/pool`, label: 'Affichage TV — Poule', variant: 'tv' }) %>
  <%- include('../partials/nav-link', { href: `/tournaments/${tournament.id}/display/final`, label: 'Affichage TV — Phases finales', variant: 'tv' }) %>
  <%- include('../partials/nav-link', { href: `/tournaments/${tournament.id}/display/finale`, label: 'Affichage TV — Finale', variant: 'tv' }) %>
  <%- include('../partials/nav-link', { href: `/tournaments/${tournament.id}/player`, label: 'Espace joueur (lien à partager)', variant: 'player' }) %>
</section>

<section class="section">
  <div class="section-head">
    <span class="section-icon is-blue">
      <%- include('../partials/icon', { name: 'box', cssClass: 'icon icon-md' }) %>
    </span>
    <div class="section-copy">
      <h2>Éléments globaux</h2>
      <p>Jeux et équipes — partagés par toutes les phases du tournoi.</p>
    </div>
  </div>
  <div class="hub-grid">
    <%- include('../partials/hub-card', {
      href: `/tournaments/${tournament.id}/games`,
      title: 'Jeux',
      desc: 'Catalogue des jeux du tournoi',
      icon: 'gamepad-2',
      tone: 'blue',
    }) %>
    <%- include('../partials/hub-card', {
      href: `/tournaments/${tournament.id}/teams`,
      title: 'Équipes',
      desc: 'Équipes et joueurs',
      icon: 'users',
      tone: 'green',
    }) %>
  </div>
</section>

<section class="section">
  <div class="section-head">
    <span class="section-icon is-gold">
      <%- include('../partials/icon', { name: 'trophy', cssClass: 'icon icon-md' }) %>
    </span>
    <div class="section-copy">
      <h2>Phases du tournoi</h2>
      <p>Manches, tirages et classement.</p>
    </div>
  </div>
  <div class="hub-grid">
    <%- include('../partials/hub-card', {
      href: `/tournaments/${tournament.id}/pool`,
      title: 'Phase de poule',
      desc: 'Manches, tirages et classement',
      icon: 'list-todo',
      tone: 'purple',
    }) %>
    <%- include('../partials/hub-card', {
      href: `/tournaments/${tournament.id}/final`,
      title: 'Phase finale',
      desc: 'Étapes à élimination',
      icon: 'trophy',
      tone: 'orange',
    }) %>
  </div>
</section>

<div class="tournament-actions">
  <% if (tournament.status === 'planned') { %>
    <form method="post" action="/tournaments/<%= tournament.id %>/start"
          onsubmit="return confirm('Démarrer ce tournoi ?');">
      <button type="submit" class="button-start">
        <%- include('../partials/icon', { name: 'play', cssClass: 'icon icon-sm' }) %>
        Démarrer ce tournoi
      </button>
    </form>
  <% } else if (tournament.status === 'open') { %>
    <form method="post" action="/tournaments/<%= tournament.id %>/close"
          onsubmit="return confirm('Clôturer ce tournoi ?');">
      <button type="submit" class="button-ghost-danger">
        <%- include('../partials/icon', { name: 'trash-2', cssClass: 'icon icon-sm' }) %>
        Clôturer ce tournoi
      </button>
    </form>
  <% } else { %>
    <form method="post" action="/tournaments/<%= tournament.id %>/reopen"
          onsubmit="return confirm('Ré-ouvrir ce tournoi ?');">
      <button type="submit" class="button-secondary">
        <%- include('../partials/icon', { name: 'rotate-ccw', cssClass: 'icon icon-sm' }) %>
        Ré-ouvrir ce tournoi
      </button>
    </form>
  <% } %>
</div>

<%- include('../partials/footer') %>
