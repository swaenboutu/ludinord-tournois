<%- include('../partials/header', { title }) %>

<%- include('../partials/breadcrumb', { items: [
  { label: 'Tournois', href: '/tournaments' },
  { label: 'Nouveau tournoi' },
] }) %>

<header class="page-header">
  <div class="page-header-main">
    <div class="page-title-row">
      <h1>Nouveau tournoi</h1>
    </div>
    <p class="page-subtitle">Nomme le tournoi et définis la taille des équipes.</p>
  </div>
</header>

<% if (typeof error !== 'undefined') { %>
  <p class="error"><%= error %></p>
<% } %>

<form method="post" action="/tournaments">
  <label>
    Nom du tournoi
    <input type="text" name="name" required maxlength="100" autofocus>
  </label>
  <label>
    Joueurs par équipe
    <input type="number" name="team_size" value="2" min="1" max="20" required>
  </label>
  <div class="form-actions">
    <button type="submit">
      <%- include('../partials/icon', { name: 'check', cssClass: 'icon icon-sm' }) %>
      Créer
    </button>
    <a class="button button-secondary" href="/tournaments">Annuler</a>
  </div>
</form>

<%- include('../partials/footer') %>
