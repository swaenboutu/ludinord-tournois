<%- include('../partials/header', { title }) %>

<header class="page-header">
  <div class="page-header-main">
    <div class="page-title-row">
      <h1>Tournois</h1>
    </div>
    <p class="page-subtitle">Crée et pilote les tournois LudiNord.</p>
  </div>
</header>

<div class="page-toolbar">
  <a class="button" href="/tournaments/new">
    <%- include('../partials/icon', { name: 'plus', cssClass: 'icon icon-sm' }) %>
    Nouveau tournoi
  </a>
</div>

<% if (tournaments.length === 0) { %>
  <p class="muted">Aucun tournoi pour le moment.</p>
<% } else { %>
  <table>
    <thead>
      <tr>
        <th>Nom</th>
        <th>Statut</th>
        <th>Créé le</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% tournaments.forEach(function (t) { %>
        <%
          var statusLabel = t.status === 'planned' ? 'Planifié'
            : (t.status === 'open' ? 'En cours' : 'Clôturé');
          var statusClass = t.status === 'planned' ? 'status-planned'
            : (t.status === 'open' ? 'status-open' : 'status-closed');
        %>
        <tr>
          <td><a href="/tournaments/<%= t.id %>"><%= t.name %></a></td>
          <td>
            <span class="status-badge <%= statusClass %> tournament-list-status">
              <span class="status-dot"></span><%= statusLabel %>
            </span>
          </td>
          <td><%= new Date(t.created_at).toLocaleDateString('fr-FR') %></td>
          <td>
            <% if (t.status === 'planned') { %>
              <form method="post" action="/tournaments/<%= t.id %>/start"
                    onsubmit="return confirm('Démarrer ce tournoi ?');">
                <button type="submit" class="button-start status-action">Démarrer</button>
              </form>
            <% } else if (t.status === 'open') { %>
              <form method="post" action="/tournaments/<%= t.id %>/close"
                    onsubmit="return confirm('Clôturer ce tournoi ?');">
                <button type="submit" class="button-danger status-action">Clôturer</button>
              </form>
            <% } else { %>
              <form method="post" action="/tournaments/<%= t.id %>/reopen"
                    onsubmit="return confirm('Ré-ouvrir ce tournoi ?');">
                <button type="submit" class="button-secondary status-action">Ré-ouvrir</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
<% } %>

<%- include('../partials/footer') %>
