<%- include('../partials/header', { title }) %>

<h1>Tournois</h1>

<p><a class="button" href="/tournaments/new">+ Nouveau tournoi</a></p>

<% if (tournaments.length === 0) { %>
  <p>Aucun tournoi pour le moment.</p>
<% } else { %>
  <table>
    <thead>
      <tr>
        <th>Nom</th>
        <th>Statut</th>
        <th>Créé le</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% tournaments.forEach(function (t) { %>
        <tr>
          <td><a href="/tournaments/<%= t.id %>"><%= t.name %></a></td>
          <td>
            <%= t.status === 'planned' ? 'Planifié'
              : (t.status === 'open' ? 'En cours' : 'Clôturé') %>
          </td>
          <td><%= new Date(t.created_at).toLocaleDateString('fr-FR') %></td>
          <td>
            <% if (t.status === 'planned') { %>
              <form method="post" action="/tournaments/<%= t.id %>/start"
                    onsubmit="return confirm('Démarrer ce tournoi ?');">
                <button type="submit" class="button-start">Démarrer</button>
              </form>
            <% } else if (t.status === 'open') { %>
              <form method="post" action="/tournaments/<%= t.id %>/close"
                    onsubmit="return confirm('Clôturer ce tournoi ?');">
                <button type="submit" class="button-danger">Clôturer</button>
              </form>
            <% } else { %>
              <form method="post" action="/tournaments/<%= t.id %>/reopen"
                    onsubmit="return confirm('Ré-ouvrir ce tournoi ?');">
                <button type="submit">Ré-ouvrir</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
<% } %>

<%- include('../partials/footer') %>
