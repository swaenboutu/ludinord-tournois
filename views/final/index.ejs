<%- include('../partials/header', { title }) %>

<%- include('../partials/breadcrumb', { items: [
  { label: 'Tournois', href: '/tournaments' },
  { label: tournament.name, href: `/tournaments/${tournament.id}` },
  { label: 'Phase finale' },
] }) %>

<header class="page-header">
  <div class="page-header-main">
    <div class="page-title-row">
      <h1>Phase finale</h1>
    </div>
    <p class="page-subtitle">Étapes à élimination jusqu'à la finale.</p>
  </div>
</header>

<div class="page-toolbar">
  <%- include('../partials/nav-link', {
    href: `/tournaments/${tournament.id}/display/final`,
    label: 'Affichage TV — Phases finales',
    variant: 'tv',
  }) %>
  <%- include('../partials/nav-link', {
    href: `/tournaments/${tournament.id}/display/finale`,
    label: 'Affichage TV — Finale',
    variant: 'tv',
  }) %>
</div>

<% if (stages.length === 0) { %>
  <p class="muted">La phase finale n'est pas encore configurée.</p>
  <% if (sizeOptions.length === 0) { %>
    <p>Il faut au moins 2 équipes dans le tournoi pour lancer une phase finale (actuellement <%= teamCount %>).</p>
  <% } else { %>
    <section class="section">
      <div class="section-head">
        <span class="section-icon is-gold">
          <%- include('../partials/icon', { name: 'trophy', cssClass: 'icon icon-md' }) %>
        </span>
        <div class="section-copy">
          <h2>Configurer</h2>
          <p>Choisis le nombre d'équipes qualifiées au départ. Les étapes suivantes gardent la moitié à chaque tour, jusqu'à la finale.</p>
        </div>
      </div>
      <form method="post" action="/tournaments/<%= tournament.id %>/final" class="inline-form">
        <label>
          Équipes qualifiées de la poule
          <select name="start_size" required>
            <% sizeOptions.forEach(function (size) { %>
              <option value="<%= size %>"><%= size %> équipes</option>
            <% }); %>
          </select>
        </label>
        <button type="submit">
          <%- include('../partials/icon', { name: 'plus', cssClass: 'icon icon-sm' }) %>
          Créer la phase finale
        </button>
      </form>
    </section>
  <% } %>
<% } else { %>
  <table>
    <thead>
      <tr>
        <th>#</th>
        <th>Étape</th>
        <th>Équipes</th>
        <th>Manches</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% stages.forEach(function (stage) { %>
        <tr>
          <td><%= stage.stage_order %></td>
          <td><a href="/tournaments/<%= tournament.id %>/final/stages/<%= stage.id %>"><%= stage.name %></a></td>
          <td><%= stage.team_assigned %> / <%= stage.team_count %></td>
          <td><%= stage.round_count %></td>
          <td><a href="/tournaments/<%= tournament.id %>/final/stages/<%= stage.id %>">Ouvrir</a></td>
        </tr>
      <% }); %>
    </tbody>
  </table>

  <form method="post" action="/tournaments/<%= tournament.id %>/final/reset" class="tournament-actions"
        onsubmit="return confirm('Réinitialiser toute la phase finale ? Étapes, tirages et résultats seront supprimés.');">
    <button type="submit" class="button-ghost-danger">
      <%- include('../partials/icon', { name: 'trash-2', cssClass: 'icon icon-sm' }) %>
      Réinitialiser la phase finale
    </button>
  </form>
<% } %>

<%- include('../partials/footer') %>
