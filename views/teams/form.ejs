<%- include('../partials/header', { title }) %>

<p><a href="/tournaments/<%= tournament.id %>/teams">← Équipes</a></p>

<h1><%= title %></h1>

<% if (typeof standing !== 'undefined' && standing) { %>
  <section class="team-summary">
    <h2>Points</h2>
    <ul>
      <% standing.players.forEach(function (pl) { %>
        <li><%= pl.pseudo %> <span class="muted">(solo)</span> : <%= pl.points %> pts</li>
      <% }); %>
      <li>Jeux en équipe : <%= standing.team_points %> pts</li>
      <li class="team-total"><strong>Total : <%= standing.total %> pts</strong></li>
    </ul>
  </section>
<% } %>

<% if (errors.length > 0) { %>
  <ul class="error">
    <% errors.forEach(function (err) { %>
      <li><%= err %></li>
    <% }); %>
  </ul>
<% } %>

<form method="post" action="<%= formAction %>">
  <label>
    Nom de l'équipe (facultatif)
    <input type="text" name="name" value="<%= values.name %>" maxlength="80"
           placeholder="Par défaut : les pseudos">
  </label>

  <label class="color-field">
    Couleur du pion
    <input type="color" name="color" value="<%= values.color %>">
  </label>

  <% values.players.forEach(function (player, i) { %>
    <fieldset>
      <legend>Joueur <%= i + 1 %></legend>
      <label>
        Pseudo
        <input type="text" name="pseudo" value="<%= player.pseudo %>"
               required maxlength="50" <%= i === 0 ? 'autofocus' : '' %>>
      </label>
      <label>
        Contact (facultatif, visible admin uniquement)
        <input type="text" name="contact" value="<%= player.contact %>" maxlength="50">
      </label>
    </fieldset>
  <% }); %>

  <div class="form-actions">
    <button type="submit">Enregistrer</button>
    <a href="/tournaments/<%= tournament.id %>/teams">Annuler</a>
  </div>
</form>

<%- include('../partials/footer') %>
