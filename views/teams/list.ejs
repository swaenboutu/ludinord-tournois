<%- include('../partials/header', { title }) %>

<%- include('../partials/breadcrumb', { items: [
  { label: 'Tournois', href: '/tournaments' },
  { label: tournament.name, href: `/tournaments/${tournament.id}` },
  { label: 'Équipes' },
] }) %>

<header class="page-header">
  <div class="page-header-main">
    <div class="page-title-row">
      <h1>Équipes</h1>
    </div>
    <p class="page-subtitle">Équipes et joueurs du tournoi.</p>
  </div>
</header>

<div class="page-toolbar">
  <a class="button" href="/tournaments/<%= tournament.id %>/teams/new">
    <%- include('../partials/icon', { name: 'plus', cssClass: 'icon icon-sm' }) %>
    Nouvelle équipe
  </a>
  <a class="button button-secondary" href="/tournaments/<%= tournament.id %>/teams/import">
    <%- include('../partials/icon', { name: 'upload', cssClass: 'icon icon-sm' }) %>
    Importer un CSV
  </a>
</div>

<% if (teams.length === 0) { %>
  <p class="muted">Aucune équipe pour le moment.</p>
<% } else { %>
  <table>
    <thead>
      <tr>
        <th>Couleur</th>
        <th>Équipe</th>
        <th>Joueurs</th>
        <th>Total</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% teams.forEach(function (team) { %>
        <%
          var pseudos = team.players.map(function (p) { return p.pseudo; });
          var displayName = team.name && team.name.trim() !== ''
            ? team.name
            : pseudos.join(' & ');
        %>
        <tr>
          <td>
            <span class="color-swatch" style="background: <%= team.color %>"
                  title="<%= team.color %>"></span>
          </td>
          <td><%= displayName %></td>
          <td><%= pseudos.join(', ') %></td>
          <td><strong><%= team.total_points %></strong> pts</td>
          <td>
            <div class="row-actions">
              <a href="/tournaments/<%= tournament.id %>/teams/<%= team.id %>/edit">Modifier</a>
              <form method="post" action="/tournaments/<%= tournament.id %>/teams/<%= team.id %>/delete"
                    onsubmit="return confirm('Supprimer cette équipe et ses joueurs ?');">
                <button type="submit" class="button-danger">Supprimer</button>
              </form>
            </div>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>

  <div class="list-danger">
    <%- include('../partials/clear-list-button', {
      action: `/tournaments/${tournament.id}/teams/clear`,
      label: 'Vider la liste',
      confirm: 'Vider toute la liste des équipes et leurs joueurs ? Cette action est irréversible.',
    }) %>
  </div>
<% } %>

<%- include('../partials/footer') %>
