<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
  <!-- Alpine.js (front léger), chargé via CDN -->
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3/dist/cdn.min.js"></script>
</head>
<body>
  <main class="container">
    <h1><%= title %></h1>
    <p>Le serveur tourne. Les interfaces (admin, saisie mobile, affichage) seront ajoutées progressivement.</p>

    <!-- Test rapide pour valider l'intégration d'Alpine -->
    <div x-data="{ ready: true }">
      <p x-show="ready">Alpine.js est bien chargé.</p>
    </div>
  </main>
</body>
</html>
